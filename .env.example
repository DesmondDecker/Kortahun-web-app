# Netlify Environment Variables
# Set these in the Netlify dashboard: Site Settings > Build & Deploy > Environment

# MongoDB Atlas Connection String (REQUIRED)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kortahun_united?retryWrites=true&w=majority

# JWT Secret (REQUIRED — use a long random string in production)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-in-production

# Node environment
NODE_ENV=production
